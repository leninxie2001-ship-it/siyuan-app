rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // who you are comes from the claims the server functions put on your sign-in: role, uname, active (and tid for teachers)
    function signedIn() { return request.auth != null && request.auth.token.active == true && request.auth.token.role in ['owner', 'staff', 'edu']; }
    function seesMoney() { return signedIn() && request.auth.token.role in ['owner', 'staff']; }
    function isOwner() { return signedIn() && request.auth.token.role == 'owner'; }
    // 老师 accounts: tied to one teacher (tid); they read the timetable and students, and write only their own attendance, grades and Zoom slots
    function isTeacher() { return request.auth != null && request.auth.token.active == true && request.auth.token.role == 'teacher' && request.auth.token.tid is string; }
    function tid() { return request.auth.token.tid; }
    function mine() { return isTeacher() && resource.data.teacherId == tid(); }
    function staysMine() { return isTeacher() && request.resource.data.teacherId == tid(); }

    // only says whether the first owner has been made, so the sign-in page knows which form to show
    match /meta/{doc} { allow read: if true; allow write: if false; }

    match /accounts/{uname} {
      allow read: if signedIn() || (isTeacher() && request.auth.token.uname == uname);
      allow create, delete: if isOwner();
      // the owner edits accounts; anyone may stamp their own last sign-in, and clear the "change your first password" flag once they have
      allow update: if isOwner() || ((signedIn() || isTeacher()) && request.auth.token.uname == uname && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt', 'mustChangePw']) && request.resource.data.get('mustChangePw', false) == false);
    }
    // 教务 and 老师 accounts never read or write money
    match /payments/{doc} { allow read, write: if seesMoney(); }
    match /vault/{doc} { allow read, write: if signedIn() && request.auth.token.uname in ['shanghen10', 'susi']; }
    // Zoom passwords only, copied from the vault by its holders so teachers can sign in to Zoom for online classes
    match /zoompw/{doc} { allow read: if signedIn() || isTeacher(); allow write: if signedIn() && request.auth.token.uname in ['shanghen10', 'susi']; }

    match /{col}/{doc} {
      allow read, write: if signedIn() && !(col in ['meta', 'accounts', 'payments', 'vault', 'zoompw']);
      allow read: if isTeacher() && col in ['students', 'teachers', 'courses', 'classes', 'holidays', 'rooms', 'locations', 'zoom'];
    }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    // teachers may correct a student's contact details and photo, and register a new student with the basics
    match /students/{id} {
      allow update: if isTeacher() && onlyChanges(['nameZh', 'nameEs', 'gender', 'birth', 'idNo', 'phone', 'email', 'address', 'parents', 'photo', 'tnote', 'updatedAt', 'updatedBy']);
      allow create: if isTeacher() && request.resource.data.createdBy == request.auth.token.uname && request.resource.data.keys().hasOnly(['nameZh', 'nameEs', 'phone', 'email', 'gender', 'birth', 'parents', 'status', 'level', 'locationId', 'code', 'regDate', 'note', 'createdAt', 'createdBy']);
    }
    // a teacher keeps their own profile (contact details, photo, introduction) up to date; name, status and pay stay with the office
    match /teachers/{id} {
      allow update: if isTeacher() && id == tid() && onlyChanges(['phone', 'wechat', 'email', 'languages', 'bio', 'photo', 'updatedAt', 'updatedBy']);
    }
    // a teacher asks the office to cancel one of their sessions or find a substitute, and may withdraw it while it is open
    match /requests/{id} {
      allow read: if mine();
      allow create: if staysMine() && request.resource.data.createdBy == request.auth.token.uname && request.resource.data.status == 'open'
        && request.resource.data.kind in ['cancel', 'sub'] && request.resource.data.keys().hasOnly(['kind', 'reason', 'status', 'sessionId', 'courseId', 'date', 'start', 'end', 'label', 'teacherId', 'createdAt', 'createdBy']);
      allow update: if mine() && resource.data.status == 'open' && request.resource.data.status == 'withdrawn' && onlyChanges(['status', 'updatedAt']);
    }
    // and add or remove students in their own classes, nothing else about the class
    match /courses/{id} {
      allow update: if mine() && onlyChanges(['studentIds', 'updatedAt', 'updatedBy']);
    }
    match /classes/{id} {
      allow update: if isTeacher() && onlyChanges(['studentIds', 'updatedAt', 'updatedBy'])
        && (resource.data.get('teacherId', '') == tid() || (resource.data.get('courseId', '') != '' && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.get('teacherId', '') == tid()));
    }
    match /zoom/{id} {
      allow create: if staysMine();
      allow update: if mine() && staysMine();
      allow delete: if mine();
    }
    // one attendance record per class session, one grade sheet per class and teacher
    match /attendance/{id} {
      allow read: if mine();
      allow create: if staysMine();
      allow update: if mine() && staysMine();
    }
    match /grades/{id} {
      allow read: if mine();
      allow create: if staysMine();
      allow update: if mine() && staysMine();
    }
  }
}

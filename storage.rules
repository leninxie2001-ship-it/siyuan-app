rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // photos, receipts, ID scans. Pages show them with plain <img> links, which carry no sign-in, so reading works
    // for anyone who has the link; each file name is a random 128-bit id that only signed-in staff ever see.
    // Uploading needs a signed-in account, up to 25 MB each.
    match /assets/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.active == true && request.auth.token.role in ['owner', 'staff', 'edu', 'teacher'] && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
